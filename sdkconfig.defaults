CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# SoftAP support is required for the Wi-Fi provisioning fallback.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# size optimization (flash/RAM pressure with WiFi + audio + LVGL)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ESP32-S3: no Classic Bluetooth / A2DP. Keep BT off to free RAM.
CONFIG_BT_ENABLED=n

# trim Wi-Fi static buffers
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# esp_audio_codec: enable only the MP3 decoder
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
# TLS client buffers: 6KB in / 4KB out is enough for Spotify endpoints
# (largest handshake record ~4KB) and avoids 16KB-contiguous alloc failures
# on this memory-tight board (mbedtls_ssl_setup -0x008D).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=6144

# 2.4GHz WiFi hop drops large segments on this network (TLS handshakes to
# accounts.spotify.com stall; 1500B passes fine on 5GHz). 536-byte MSS keeps
# every segment well under the loss threshold.
CONFIG_LWIP_TCP_MSS=536

# Default audio path: AUX PCM5102 over I2S
CONFIG_PLAYER_AUDIO_OUT_I2S=y
CONFIG_PLAYER_AUDIO_EN_GPIO=-1
CONFIG_PLAYER_AUX_BCK_GPIO=41
CONFIG_PLAYER_AUX_DIN_GPIO=40
CONFIG_PLAYER_AUX_LRCK_GPIO=39
CONFIG_PLAYER_AUX_SCK_GPIO=42
CONFIG_PLAYER_AUX_DET_GPIO=38

CONFIG_PLAYER_SD_CS_GPIO=21
CONFIG_PLAYER_SD_MOSI_GPIO=11
CONFIG_PLAYER_SD_MISO_GPIO=12
CONFIG_PLAYER_SD_SCK_GPIO=14
CONFIG_PLAYER_SD_CD_GPIO=47

# HS20HS072RX is a color TFT. Montserrat 16 is the body font, 20 the titles.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
# CONFIG_LV_FONT_UNSCII_8 is not set
# CONFIG_LV_FONT_DEFAULT_UNSCII_8 is not set
# CONFIG_LV_USE_THEME_MONO is not set
