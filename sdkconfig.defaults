CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# SoftAP support is required for the Wi-Fi provisioning fallback.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# size optimization (flash/RAM pressure with BT+WiFi+LVGL+audio codec)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# lcd display
CONFIG_LCD_HRES=320
CONFIG_LCD_VRES=240
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# bluetooth classic A2DP sink (Bluedroid), BLE disabled to save memory
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n

# no PSRAM on this board (ESP32-WROOM-32E). Move LVGL off its 64KB static
# heap pool and onto the C library allocator so it no longer consumes the
# scarce internal DRAM segment.
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y

# trim Wi-Fi static buffers (Wi-Fi is only used for the optional Web API)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# A2DP + AVRCP transport only; no cover-art / object-exchange profiles
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
CONFIG_BT_GOEPC_ENABLED=n

# esp_audio_codec: enable only the MP3 decoder
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_XPT2046_Z_THRESHOLD=200
